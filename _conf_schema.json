{
  "prefix": {
    "description": "指令前缀",
    "type": "object",
    "items": {
      "enable": {
        "description": "是否启用插件前缀",
        "type": "bool",
        "default": false,
        "hint": "默认关闭，走 AstrBot 默认前缀 /。开启后需额外匹配下方前缀。"
      },
      "text": {
        "description": "前缀内容",
        "type": "string",
        "default": "剑三",
        "hint": "仅在启用插件前缀时生效。"
      }
    }
  },
  "jx3api_token": {
    "description": "全局 JX3API Token",
    "type": "string",
    "default": "",
    "hint": "前往 https://www.jx3api.com/ 购买。仅当会话勾选「使用全局 Token」时才会使用。"
  },
  "jx3api_ticket": {
    "description": "全局推栏标识",
    "type": "string",
    "default": "",
    "hint": "默认全部会话使用这份推栏标识；会话自定义后优先用自定义。"
  }
}
